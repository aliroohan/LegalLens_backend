NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/legallens
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
PYTHON_FORENSICS_URL=http://127.0.0.1:8000
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CORS_ORIGIN=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173

# Optional SMTP. When unset, reset and credential emails are logged on the server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LegalLens <no-reply@legallens.local>
